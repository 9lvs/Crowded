# Copy to backend/.env for local dev. Never commit a real .env.
CROWDED_ENV=dev
CROWDED_DATABASE_URL=postgresql+psycopg://crowded:crowded@localhost:5432/crowded

# Required outside dev/test. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
CROWDED_JWT_SECRET=
CROWDED_HASH_PEPPER=

# JSON list of allowed browser origins. Empty means same origin only.
CROWDED_CORS_ORIGINS=[]
# Set true only behind a proxy you control that sets X-Forwarded-For.
CROWDED_TRUST_PROXY_HEADERS=false

CROWDED_APPLE_CLIENT_ID=app.crowded.ios
CROWDED_RAW_RETENTION_DAYS=30
